import re

results = []

with open("dd_output.log", "r") as f:
    date = None
    for line in f:
        if line.startswith("Ran on"):
            date = line.strip().replace("Ran on ", "")
        elif "copied" in line and "s," in line:
            # speed is the last item after the comma
            speed = line.strip().split(",")[-1].strip()
            if date:
                results.append((date, speed))
                date = None  # reset for next block

# Print results
for d, s in results:
    print(f"{d} -> {s}")



