#!/bin/bash

# Define constants
NODE_ID="$SLURM_NODENAME"
MAX_RETRIES=3
SLEEP_INTERVAL=2
SQUEUE_PATH="/usr/bin/squeue"

# 1. Allow a brief moment for the controller to catch up
sleep 1

for ((i=1; i<=MAX_RETRIES; i++)); do
    # Count jobs that are NOT the one currently finishing
    # We exclude the current job ID ($SLURM_JOB_ID) specifically
    OTHER_JOBS=$($SQUEUE_PATH -w "$NODE_ID" -h -t R,CF,CG | grep -v "$SLURM_JOBID" | wc -l)

    if [ "$OTHER_JOBS" -gt 0 ]; then
        # Another job is definitely there. Exit immediately.
        exit 0
    fi

    # If we see 0 other jobs, wait and re-verify to be sure no new job was just scheduled
    sleep "$SLEEP_INTERVAL"
done

# 2. Final verification: If we reached here and count is still 0, the node is idle.
FINAL_CHECK=$($SQUEUE_PATH -w "$NODE_ID" -h -t R,CF,CG | grep -v "$SLURM_JOBID" | wc -l)

if [ "$FINAL_CHECK" -eq 0 ]; then
    # Run your test script
    /usr/local/bin/node_health_check.sh >> /var/log/slurm/node_test.log 2>&1
fi


        
    
                    
