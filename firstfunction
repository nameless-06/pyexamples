import re
import csv
from pathlib import Path
from datetime import datetime
from collections import defaultdict

log_file = "nfs_check_output.log"

date_re = re.compile(r"\*{6}Ran on (.*)\*{6}")
dir_re = re.compile(r"Dir:\s+(.*)")
real_re = re.compile(r"real\s+(\d+m\d+\.\d+s|\d+\.\d+s|\d+m\d+s|\d+s)")

def time_to_seconds(t: str) -> float:
    t = t.strip("s")
    if "m" in t:
        minutes, seconds = t.split("m")
        return int(minutes) * 60 + float(seconds)
    return float(t)

out_dir = Path("csv_dir")
out_dir.mkdir(exist_ok=True)

# store results before writing
results = defaultdict(list)

current_date = None
current_path = None

with open(log_file) as f:
    for line in f:
        line = line.strip()
        
        m = date_re.match(line)
        if m:
            raw_date = m.group(1).strip()
            try:
                dt = datetime.strptime(raw_date, "%a %b %d %H:%M:%S %Z %Y")
            except ValueError:
                dt = datetime.strptime(raw_date, "%a %b %d %H:%M:%S %Y")
            current_date = dt.strftime("%Y-%m-%d %H:%M:%S")
            continue
        
        m = dir_re.match(line)
        if m:
            path = m.group(1).strip()
            base_path = "/".join(path.strip("/").split("/")[:-1])
            current_path = base_path.replace("/", "_")
            continue
        
        m = real_re.match(line)
        if m and current_date and current_path:
            real_sec = time_to_seconds(m.group(1))
            results[current_path].append((current_date, real_sec))
            current_path = None

# write fresh CSVs
for vol, rows in results.items():
    csv_file = out_dir / f"{vol}.csv"
    with open(csv_file, "w", newline="") as csvf:
        writer = csv.writer(csvf)
        writer.writerow(["Date", "Real"])
        writer.writerows(rows)

---
- name: Check user IDs on all servers
  hosts: all
  gather_facts: no
  vars:
    user_file: users.txt

  tasks:
    - name: Read list of user IDs from file (on control node)
      delegate_to: localhost
      run_once: true
      command: cat {{ user_file }}
      register: user_file_contents

    - name: Set user list fact
      set_fact:
        users: "{{ user_file_contents.stdout_lines }}"

    - name: Run 'id' command for each user
      command: "id {{ item }}"
      loop: "{{ users }}"
      register: user_id_results
      ignore_errors: yes

    - name: Display results
      debug:
        msg: |
          Server: {{ inventory_hostname }}
          {% for r in user_id_results.results %}
          - User: {{ r.item }} => {{ r.stdout | default(r.stderr) }}
          {% endfor %}

        
                