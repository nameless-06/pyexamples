import csv
from datetime import datetime

with open("dd_speed.csv", "w", newline="") as csvfile:
    writer = csv.writer(csvfile)
    writer.writerow(["time", "speed_MBps"])  # header
    
    with open("dd_output.log", "r") as f:
        date = None
        for line in f:
            if line.startswith("Ran on date"):
                raw_date = line.strip().replace("Ran on date ", "")
                # Parse "Mon Sep 22 12:00:01 UTC 2025" to ISO
                dt = datetime.strptime(raw_date, "%a %b %d %H:%M:%S %Z %Y")
                date = dt.isoformat()
            elif "copied" in line and "s," in line:
                speed_raw = line.strip().split(",")[-1].strip()
                num, unit = speed_raw.split()

                num = float(num)
                if unit.upper() == "KB/S":
                    num = num / 1024
                elif unit.upper() == "GB/S":
                    num = num * 1024

                if date:
                    writer.writerow([date, num])
                    date = None
